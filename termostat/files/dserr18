#!/bin/sh
# --- КОНСТАНТИ ТА ПОЧАТКОВЕ СКИДАННЯ ---
TTESTT="/tmp/zawis.gp"
TMP_FILE="/tmp/zawis.tmp"

# Атомарний запис на старті
echo "zwser 1" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"

# --- ГОЛОВНИЙ ЦИКЛ МОНІТОРИНГУ ---
while true; do
    read -r label mrd < "$TTESTT" 2>/dev/null
    [ -z "$mrd" ] && mrd=1

    if [ "$mrd" = "10" ]; then
        osb=2
        retry_count=0
        
        while [ "1" != "$osb" ] && [ "$retry_count" -lt 5 ]; do
            /etc/init.d/ds18b20_init stop > /dev/null 2>&1
            sleep 1
            
            if ! pidof ds18b20 > /dev/null; then
                logger -t dserr18 "ds18b20 stopped. Restarting service, retry #$retry_count"
                /etc/init.d/ds18b20_init start > /dev/null 2>&1
                osb=1
                sleep 10
            else
                logger -t dserr18 "ds18b20 HANGED. Sending SIGKILL -9, retry #$retry_count"
                killall -9 ds18b20 > /dev/null 2>&1
                sleep 1
            fi
            retry_count=$((retry_count + 1))
        done

        # --- ПЕРЕВІРКА ЗАВИСАННЯ ШИНИ ЯДРА ---
        if [ "$osb" != "1" ]; then
            logger -t dserr18 "CRITICAL: killall -9 failed. Resetting kernel module..."
            /etc/init.d/ds18b20_init stop > /dev/null 2>&1
            killall -9 ds18b20 > /dev/null 2>&1
            sleep 1
            
            # Вивантажуємо завислий драйвер шини
            rmmod w1-gpio-custom > /dev/null 2>&1
            sleep 1
            
            # ЗАХИСТ ВІД ДУБЛЮВАННЯ: Гасимо поточний моніторинг, 
            # оскільки ds18b20_init start зараз запустить його заново
            logger -t dserr18 "Reloading hardware. Respawning fresh watchdog instance..."
            
            # Запускаємо чистий старт (він підніме драйвер, html, бінарник і НОВИЙ dserr18)
            /etc/init.d/ds18b20_init start > /dev/null 2>&1
            
            # М'яко завершуємо цей (старий) процес, щоб звільнити пам'ять
            exit 0
        fi

        echo "zwser 1" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"
    else
        mrd=$((mrd + 1))
        echo "zwser $mrd" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"
    fi
    
    sleep 1
done

