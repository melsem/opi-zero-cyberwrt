#!/bin/sh
# --- КОНСТАНТИ ТА ПОЧАТКОВЕ СКИДАННЯ ---
TTESTT="/tmp/zawis.gp"
TMP_FILE="/tmp/zawis.tmp"

# Атомарний запис на старті
echo "zwser 1" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"

# --- ГОЛОВНИЙ ЦИКЛ МОНІТОРИНГУ ---
while true; do
    read -r label mrd < "$TTESTT" 2>/dev/null
    [ -z "$mrd" ] && mrd=1

    if [ "$mrd" = "10" ]; then
        osb=2
        retry_count=0
        
        while [ "1" != "$osb" ] && [ "$retry_count" -lt 5 ]; do
            /etc/init.d/ds18b20_init stop 1 > /dev/null 2>&1
            sleep 1
            
            if ! pidof ds18b20 > /dev/null; then
                logger -t DSERR18 "ds18b20 stopped. Restarting service, retry #$retry_count"
                /etc/init.d/ds18b20_init start 1 > /dev/null 2>&1
                osb=1
                sleep 10
            else
                logger -t DSERR18 "ds18b20 HANGED. Sending SIGKILL -9, retry #$retry_count"
                killall -9 ds18b20 > /dev/null 2>&1
                sleep 1
            fi
            retry_count=$((retry_count + 1))
        done

        # --- ПЕРЕВІРКА ЗАВИСАННЯ ШИНИ ЯДРА ---
        if [ "$osb" != "1" ]; then
            logger -t DSERR18 "CRITICAL: Service stop failed. Resetting 1-Wire kernel stack..."
            /etc/init.d/ds18b20_init stop 1 > /dev/null 2>&1
            sleep 1
            
            logger -t DSERR18 "Hardware W1 stack reloaded. Restarting daemon..."
            /etc/init.d/ds18b20_init start 1 > /dev/null 2>&1
            
            # М'яко завершуємо цей процес, щоб уникнути дублювання
            exit 0
        fi

        echo "zwser 1" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"
    else
        mrd=$((mrd + 1))
        echo "zwser $mrd" > "$TMP_FILE" && mv "$TMP_FILE" "$TTESTT"
    fi
    
    sleep 1
done

